##################################################
# BOT PERSONALITY CONFIGURATION                  #
##################################################

# Enable the Phase 1 bot personality system.
# Default: 1
BotPersonality.Enable = 1

# Generate or load a persistent personality when a Playerbot enters the world.
# Default: 1
BotPersonality.GenerateOnLogin = 1

# Save newly generated personalities to the characters database.
# Default: 1
BotPersonality.SaveGenerated = 1

# Enable extra diagnostic logging for personality cache/load behavior.
# Default: 0
BotPersonality.DebugLogging = 0

# Maximum deterministic random variation applied to each trait.
# Valid range: 0-40
# Default: 15
BotPersonality.Variation = 15

##################################################
# BOT PERSONALITY RELATIONSHIP CONFIGURATION     #
##################################################

# Enable persistent per-bot/per-player relationships.
# Default: 1
BotPersonality.Relationship.Enable = 1

# Allow accepted chat interactions to update relationships.
# Default: 1
BotPersonality.Relationship.UpdateFromChat = 1

# Enable extra diagnostics for relationship cache, deltas, saves, and caps.
# Default: 0
BotPersonality.Relationship.DebugLogging = 0

# Relationship value range.
# Defaults: -1000 and 1000
BotPersonality.Relationship.Minimum = -1000
BotPersonality.Relationship.Maximum = 1000

# Dirty relationship save interval in seconds.
# Valid range: 5-3600
# Default: 60
BotPersonality.Relationship.SaveIntervalSeconds = 60

# Relationship cache expiry and maximum cached bot/player pairs.
# Valid ranges: 1-1440 minutes, 100-100000 entries
BotPersonality.Relationship.CacheExpiryMinutes = 30
BotPersonality.Relationship.MaxCachedEntries = 10000

# Diminishing returns for repeated relationship events.
# Valid ranges: 0-86400 seconds, 0-100 percent
BotPersonality.Relationship.RepeatWindowSeconds = 600
BotPersonality.Relationship.SecondRepeatPercent = 50
BotPersonality.Relationship.ThirdRepeatPercent = 25
BotPersonality.Relationship.FurtherRepeatPercent = 0

# Rolling in-memory 24-hour caps per bot/player pair.
# Server restart resets these caps, but persisted relationships remain.
# Valid range: 0-10000
BotPersonality.Relationship.MaxPositiveChatGainPerDay = 20
BotPersonality.Relationship.MaxNegativeChatLossPerDay = 40
BotPersonality.Relationship.MaxFamiliarityGainPerDay = 30

# Base chat event effects. Personality may scale these bounded deltas.
# Valid range for each value: -100 to 100
BotPersonality.Relationship.GreetingAffinity = 1
BotPersonality.Relationship.GreetingFamiliarity = 2

BotPersonality.Relationship.ThanksAffinity = 2
BotPersonality.Relationship.ThanksTrust = 1
BotPersonality.Relationship.ThanksFamiliarity = 1

BotPersonality.Relationship.PraiseAffinity = 2
BotPersonality.Relationship.PraiseRespect = 1
BotPersonality.Relationship.PraiseFamiliarity = 1

BotPersonality.Relationship.ApologyAffinity = 1
BotPersonality.Relationship.ApologyTrust = 2
BotPersonality.Relationship.ApologyFamiliarity = 1

BotPersonality.Relationship.InsultAffinity = -5
BotPersonality.Relationship.InsultTrust = -2
BotPersonality.Relationship.InsultRespect = -1
BotPersonality.Relationship.InsultFamiliarity = 1

BotPersonality.Relationship.HelpFamiliarity = 1
BotPersonality.Relationship.ConversationFamiliarity = 1

BotPersonality.Relationship.SpamAffinity = -2
BotPersonality.Relationship.SpamTrust = -1
BotPersonality.Relationship.SpamRespect = -1

##################################################
# BOT PERSONALITY GAMEPLAY CONFIGURATION         #
##################################################

# Enable gameplay-driven relationship tracking.
# Default: 1
BotPersonality.Gameplay.Enable = 1

# Apply detected gameplay events to persistent relationships.
# Disable to keep debug tracking without changing relationship values.
# Default: 1
BotPersonality.Gameplay.UpdateRelationships = 1

# Enable extra diagnostics for gameplay event detection and deltas.
# Default: 0
BotPersonality.Gameplay.DebugLogging = 0

# Enable/disable event families.
BotPersonality.Gameplay.TrackNormalKills = 1
BotPersonality.Gameplay.TrackEliteKills = 1
BotPersonality.Gameplay.TrackBossKills = 1
BotPersonality.Gameplay.TrackHealing = 1
BotPersonality.Gameplay.TrackResurrection = 1
BotPersonality.Gameplay.TrackDeaths = 1
BotPersonality.Gameplay.TrackGroupWipes = 1
BotPersonality.Gameplay.TrackGroupLeaves = 1
BotPersonality.Gameplay.TrackEncounterCompletion = 1
BotPersonality.Gameplay.TrackSustainedTeamwork = 1

# Track battleground/arena PvP events. Disabled by default to avoid noisy
# relationship changes from PvP deaths and heals.
# Default: 0
BotPersonality.Gameplay.AllowPvPEvents = 0

# Maximum distance for shared kill, heal, death, and wipe participation.
# Valid range: 10-500
# Default: 120
BotPersonality.Gameplay.ParticipationDistance = 120

# Normal kills are batched to reduce trash-farming value.
# Valid ranges: batch 1-50, window 5-3600 seconds
BotPersonality.Gameplay.NormalKillBatchSize = 3
BotPersonality.Gameplay.NormalKillWindowSeconds = 300

# Healing must accumulate this much effective healing in the window before a
# relationship event is applied.
# Valid ranges: threshold 1-100000, window 1-300 seconds
BotPersonality.Gameplay.HealThreshold = 500
BotPersonality.Gameplay.HealWindowSeconds = 20

# Death window used for shared deaths and repeated player deaths.
# Valid ranges: window 5-3600 seconds, threshold 2-20 deaths
BotPersonality.Gameplay.DeathWindowSeconds = 120
BotPersonality.Gameplay.RepeatedDeathThreshold = 3

# Time grouped together before a sustained-teamwork event can fire.
# Valid range: 60-86400 seconds
# Default: 1200
BotPersonality.Gameplay.SustainedTeamworkSeconds = 1200

# Minimum nearby group members that must all be dead for a group wipe event.
# Valid range: 2-40
# Default: 3
BotPersonality.Gameplay.MinimumWipeMembers = 3

# Rolling in-memory one-hour caps per bot/player pair.
# Server restart resets these caps, but persisted relationships remain.
# Valid range: 0-10000
BotPersonality.Gameplay.MaxPositiveGainPerHour = 40
BotPersonality.Gameplay.MaxNegativeLossPerHour = 50
BotPersonality.Gameplay.MaxFamiliarityGainPerHour = 60

# Per-pair event cooldowns in seconds.
BotPersonality.Gameplay.NormalKillCooldownSeconds = 60
BotPersonality.Gameplay.EliteKillCooldownSeconds = 90
BotPersonality.Gameplay.BossKillCooldownSeconds = 300
BotPersonality.Gameplay.HealCooldownSeconds = 45
BotPersonality.Gameplay.ResurrectionCooldownSeconds = 300
BotPersonality.Gameplay.DeathCooldownSeconds = 90
BotPersonality.Gameplay.WipeCooldownSeconds = 300
BotPersonality.Gameplay.GroupLeaveCooldownSeconds = 300
BotPersonality.Gameplay.EncounterCooldownSeconds = 600
BotPersonality.Gameplay.TeamworkCooldownSeconds = 1200

# Base gameplay event effects. Personality may scale these bounded deltas.
# Valid range for each value: -100 to 100
BotPersonality.Gameplay.SharedNormalKillAffinity = 1
BotPersonality.Gameplay.SharedNormalKillTrust = 0
BotPersonality.Gameplay.SharedNormalKillRespect = 1
BotPersonality.Gameplay.SharedNormalKillFamiliarity = 1

BotPersonality.Gameplay.SharedEliteKillAffinity = 2
BotPersonality.Gameplay.SharedEliteKillTrust = 1
BotPersonality.Gameplay.SharedEliteKillRespect = 2
BotPersonality.Gameplay.SharedEliteKillFamiliarity = 2

BotPersonality.Gameplay.SharedBossKillAffinity = 5
BotPersonality.Gameplay.SharedBossKillTrust = 3
BotPersonality.Gameplay.SharedBossKillRespect = 5
BotPersonality.Gameplay.SharedBossKillFamiliarity = 3

BotPersonality.Gameplay.PlayerHealedBotAffinity = 3
BotPersonality.Gameplay.PlayerHealedBotTrust = 3
BotPersonality.Gameplay.PlayerHealedBotRespect = 1
BotPersonality.Gameplay.PlayerHealedBotFamiliarity = 2

BotPersonality.Gameplay.PlayerResurrectedBotAffinity = 6
BotPersonality.Gameplay.PlayerResurrectedBotTrust = 5
BotPersonality.Gameplay.PlayerResurrectedBotRespect = 2
BotPersonality.Gameplay.PlayerResurrectedBotFamiliarity = 4

BotPersonality.Gameplay.BotHealedPlayerAffinity = 1
BotPersonality.Gameplay.BotHealedPlayerTrust = 1
BotPersonality.Gameplay.BotHealedPlayerRespect = 1
BotPersonality.Gameplay.BotHealedPlayerFamiliarity = 2

BotPersonality.Gameplay.BotResurrectedPlayerAffinity = 2
BotPersonality.Gameplay.BotResurrectedPlayerTrust = 2
BotPersonality.Gameplay.BotResurrectedPlayerRespect = 1
BotPersonality.Gameplay.BotResurrectedPlayerFamiliarity = 3

BotPersonality.Gameplay.PlayerDiedAffinity = -1
BotPersonality.Gameplay.PlayerDiedTrust = -1
BotPersonality.Gameplay.PlayerDiedRespect = -2
BotPersonality.Gameplay.PlayerDiedFamiliarity = 1

BotPersonality.Gameplay.BotDiedAffinity = -2
BotPersonality.Gameplay.BotDiedTrust = -2
BotPersonality.Gameplay.BotDiedRespect = -1
BotPersonality.Gameplay.BotDiedFamiliarity = 1

BotPersonality.Gameplay.SharedDeathAffinity = -1
BotPersonality.Gameplay.SharedDeathTrust = 0
BotPersonality.Gameplay.SharedDeathRespect = -1
BotPersonality.Gameplay.SharedDeathFamiliarity = 2

BotPersonality.Gameplay.GroupWipeAffinity = -3
BotPersonality.Gameplay.GroupWipeTrust = -3
BotPersonality.Gameplay.GroupWipeRespect = -3
BotPersonality.Gameplay.GroupWipeFamiliarity = 2

BotPersonality.Gameplay.PlayerLeftGroupDuringCombatAffinity = -8
BotPersonality.Gameplay.PlayerLeftGroupDuringCombatTrust = -6
BotPersonality.Gameplay.PlayerLeftGroupDuringCombatRespect = -4
BotPersonality.Gameplay.PlayerLeftGroupDuringCombatFamiliarity = 0

BotPersonality.Gameplay.DungeonCompletedAffinity = 8
BotPersonality.Gameplay.DungeonCompletedTrust = 4
BotPersonality.Gameplay.DungeonCompletedRespect = 8
BotPersonality.Gameplay.DungeonCompletedFamiliarity = 6

BotPersonality.Gameplay.RaidEncounterCompletedAffinity = 6
BotPersonality.Gameplay.RaidEncounterCompletedTrust = 3
BotPersonality.Gameplay.RaidEncounterCompletedRespect = 6
BotPersonality.Gameplay.RaidEncounterCompletedFamiliarity = 4

BotPersonality.Gameplay.SustainedTeamworkAffinity = 2
BotPersonality.Gameplay.SustainedTeamworkTrust = 2
BotPersonality.Gameplay.SustainedTeamworkRespect = 1
BotPersonality.Gameplay.SustainedTeamworkFamiliarity = 4

BotPersonality.Gameplay.RepeatedPlayerDeathAffinity = -3
BotPersonality.Gameplay.RepeatedPlayerDeathTrust = -2
BotPersonality.Gameplay.RepeatedPlayerDeathRespect = -4
BotPersonality.Gameplay.RepeatedPlayerDeathFamiliarity = 1

##################################################
# BOT PERSONALITY CHAT CONFIGURATION             #
##################################################

# Enable Phase 2 template-based personality chat.
# Default: 1
BotPersonality.Chat.Enable = 1

# Allow Playerbots to answer eligible direct whispers from real players.
# Default: 1
BotPersonality.Chat.RespondToWhispers = 1

# Allow one eligible Playerbot to answer real player party/raid chat.
# Default: 1
BotPersonality.Chat.RespondToGroupChat = 1

# Allow low-probability responses for messages with no recognized intent.
# Default: 1
BotPersonality.Chat.RespondToUnknown = 1

# Force eligible responses to 100% for debugging.
# Default: 0
BotPersonality.Chat.ForceResponseForDebug = 0

# Per bot/player pair cooldown in milliseconds.
# Valid range: 0-600000
# Default: 5000
BotPersonality.Chat.PairCooldownMs = 5000

# Per bot global chat cooldown in milliseconds.
# Valid range: 0-600000
# Default: 2000
BotPersonality.Chat.BotCooldownMs = 2000

# Suppress duplicate messages from the same player to the same bot.
# Valid range: 0-600000
# Default: 15000
BotPersonality.Chat.DuplicateWindowMs = 15000

# Maximum successful responses per bot in a rolling one-minute window.
# Valid range: 1-60
# Default: 8
BotPersonality.Chat.MaxResponsesPerMinute = 8

# Keep the same bot as speaker for follow-up party/raid conversation.
# Set to 0 to select a new speaker for every message.
BotPersonality.Chat.GroupConversationSpeakerTimeoutSeconds = 90

# Maximum input length considered by personality chat.
# Valid range: 1-255
# Default: 255
BotPersonality.Chat.MaxInputLength = 255

# Maximum output length sent by personality chat.
# Valid range: 1-255
# Default: 255
BotPersonality.Chat.MaxOutputLength = 255

# Minimum response chances for important recognized intents.
# Valid range: 0-100
BotPersonality.Chat.MinimumGreetingChance = 70
BotPersonality.Chat.MinimumHelpChance = 85
BotPersonality.Chat.MinimumIdentityChance = 85
BotPersonality.Chat.MinimumThanksChance = 50
BotPersonality.Chat.MinimumInsultChance = 40

# Response chance for unknown messages when unknown responses are enabled.
# Valid range: 0-100
# Default: 25
BotPersonality.Chat.UnknownChance = 25

# Add a human-like delay before bot reactive chat replies are sent.
# This only delays the reply; the WoW 3.3.5a client has no typing indicator.
# Default: 1
BotPersonality.Chat.ReplyDelay.Enable = 1

# Base reply delay in milliseconds.
# Valid range: 0-60000
# Default: 700
BotPersonality.Chat.ReplyDelay.BaseMs = 700

# Extra delay per input character, simulating reading time.
# Valid range: 0-250
# Default: 8
BotPersonality.Chat.ReplyDelay.InputCharMs = 8

# Extra delay per output character, simulating typing time.
# Valid range: 0-250
# Default: 45
BotPersonality.Chat.ReplyDelay.OutputCharMs = 45

# Random delay added to each reply in milliseconds.
# Valid range: 0-60000
# Default: 1200
BotPersonality.Chat.ReplyDelay.RandomMs = 1200

# Maximum reply delay in milliseconds. Set to 0 for no cap.
# Valid range: 0-60000
# Default: 10000
BotPersonality.Chat.ReplyDelay.MaxMs = 10000

# Enable extra diagnostics for chat validation, intent, cooldowns, and sending.
# Message contents are redacted from logs.
# Default: 0
BotPersonality.Chat.DebugLogging = 0

##################################################
# BOT PERSONALITY MOOD CONFIGURATION             #
##################################################

# Enable temporary in-memory bot mood.
# Default: 1
BotPersonality.Mood.Enable = 1

# Enable diagnostics for mood cache, deltas, clamping, and decay.
# Default: 0
BotPersonality.Mood.DebugLogging = 0

# Mood value range. Mood is transient and is not persisted to the database.
BotPersonality.Mood.Minimum = 0
BotPersonality.Mood.Maximum = 100

# Mood decay moves values toward personality-derived baselines.
BotPersonality.Mood.DecayIntervalSeconds = 30
BotPersonality.Mood.HappinessDecay = 1
BotPersonality.Mood.FrustrationDecay = 2
BotPersonality.Mood.ConfidenceDecay = 1
BotPersonality.Mood.FearDecay = 2
BotPersonality.Mood.ExcitementDecay = 2
BotPersonality.Mood.BoredomDecay = 1

# In-memory mood cache expiry, size, and per-update decay batch.
BotPersonality.Mood.CacheExpiryMinutes = 60
BotPersonality.Mood.MaxCachedBots = 5000
BotPersonality.Mood.DecayBatchSize = 200

##################################################
# BOT PERSONALITY PROACTIVE CHAT CONFIGURATION   #
##################################################

# Enable event-driven contextual party/raid dialogue.
# Default: 1
BotPersonality.ProactiveChat.Enable = 1

# Enable diagnostics for queueing, suppression, speaker selection, and sends.
# Default: 0
BotPersonality.ProactiveChat.DebugLogging = 0

# Require at least one online real player before proactive dialogue is sent.
BotPersonality.ProactiveChat.RequireRealPlayerPresent = 1

# Proactive output channels. Raid chat is normal raid chat, not raid warning.
BotPersonality.ProactiveChat.EnablePartyChat = 1
BotPersonality.ProactiveChat.EnableRaidChat = 1
BotPersonality.ProactiveChat.EnableSay = 0

# Short, bounded bot-to-bot banter after a primary contextual line.
BotPersonality.ProactiveChat.EnableBotBanter = 1
BotPersonality.ProactiveChat.BotBanterChance = 15
BotPersonality.ProactiveChat.BotBanterDelayMinMs = 1500
BotPersonality.ProactiveChat.BotBanterDelayMaxMs = 4000
BotPersonality.ProactiveChat.MaxBanterReplies = 1

# Primary proactive message delay.
BotPersonality.ProactiveChat.DelayMinMs = 500
BotPersonality.ProactiveChat.DelayMaxMs = 2500

# Group, bot, and topic cooldowns.
BotPersonality.ProactiveChat.GroupCooldownMs = 12000
BotPersonality.ProactiveChat.BotCooldownMs = 30000
BotPersonality.ProactiveChat.EventTypeCooldownMs = 60000

# Rolling one-minute message limits.
BotPersonality.ProactiveChat.MaxMessagesPerGroupPerMinute = 4
BotPersonality.ProactiveChat.MaxMessagesPerBotPerMinute = 2

# Bounded event queues.
BotPersonality.ProactiveChat.MaxQueuedEventsGlobal = 1000
BotPersonality.ProactiveChat.MaxQueuedEventsPerGroup = 10
BotPersonality.ProactiveChat.EventExpirySeconds = 20

# Quiet periods after noisy high-priority topics.
BotPersonality.ProactiveChat.PostWipeQuietSeconds = 20
BotPersonality.ProactiveChat.PostCompletionQuietSeconds = 10
BotPersonality.ProactiveChat.PostBossQuietSeconds = 8

# Base dialogue chances by event family.
BotPersonality.ProactiveChat.GroupJoinChance = 35
BotPersonality.ProactiveChat.DungeonEnterChance = 40
BotPersonality.ProactiveChat.EliteKillChance = 15
BotPersonality.ProactiveChat.BossKillChance = 75
BotPersonality.ProactiveChat.BotHealedChance = 15
BotPersonality.ProactiveChat.BotSavedChance = 65
BotPersonality.ProactiveChat.BotResurrectedChance = 80
BotPersonality.ProactiveChat.PlayerDeathChance = 10
BotPersonality.ProactiveChat.RepeatedPlayerDeathChance = 45
BotPersonality.ProactiveChat.BotDeathChance = 20
BotPersonality.ProactiveChat.WipeChance = 70
BotPersonality.ProactiveChat.DungeonCompleteChance = 90
BotPersonality.ProactiveChat.RaidEncounterCompleteChance = 80
BotPersonality.ProactiveChat.DangerousPullChance = 30
BotPersonality.ProactiveChat.AbandonmentChance = 75
BotPersonality.ProactiveChat.LowHealthChance = 5
BotPersonality.ProactiveChat.CriticalHealthChance = 25
BotPersonality.ProactiveChat.LowManaChance = 8
BotPersonality.ProactiveChat.InactivityChance = 15
BotPersonality.ProactiveChat.TeamworkChance = 20

# Low-health and low-mana threshold crossing detection for tracked bots.
BotPersonality.ProactiveChat.LowHealthPercent = 30
BotPersonality.ProactiveChat.CriticalHealthPercent = 15
BotPersonality.ProactiveChat.LowManaPercent = 20
BotPersonality.ProactiveChat.LowHealthCooldownSeconds = 120
BotPersonality.ProactiveChat.CriticalHealthCooldownSeconds = 60
BotPersonality.ProactiveChat.LowManaCooldownSeconds = 120

# Inactivity dialogue only checks bots already tracked by recent group events.
BotPersonality.ProactiveChat.EnableInactivityDialogue = 1
BotPersonality.ProactiveChat.InactivityMinutes = 5
BotPersonality.ProactiveChat.InactivityCooldownMinutes = 15

##################################################
# BOT PERSONALITY LLM CONFIGURATION              #
##################################################

# Enable optional OpenAI-compatible LLM dialogue generation.
# The model only generates wording; server logic remains authoritative.
# Default: 0
BotPersonality.LLM.Enable = 0

# Enable LLM diagnostics. Prompts/responses remain redacted unless the separate
# restricted prompt logging options are enabled.
# Default: 0
BotPersonality.LLM.DebugLogging = 0

# Provider mode: Template, Llm, or Hybrid.
# Template never calls the endpoint. Hybrid uses configured routes.
# Default: Hybrid
BotPersonality.LLM.Mode = Hybrid

BotPersonality.LLM.EnableForWhispers = 1
BotPersonality.LLM.EnableForGroupChat = 1
BotPersonality.LLM.EnableForProactiveChat = 1
BotPersonality.LLM.EnableForBotBanter = 0

# Suspend mod-playerbots whisper/party command parsing while LLM mode is active.
# This keeps normal phrases such as "inventory", "guild", or "where is the inn"
# conversational instead of triggering command output.
BotPersonality.LLM.SuppressPlayerbotsCommands = 1

# OpenAI-compatible Chat Completions endpoint.
# This implementation supports plain HTTP endpoints from worker threads.
BotPersonality.LLM.Endpoint = http://127.0.0.1:11434/v1/chat/completions
BotPersonality.LLM.AllowRemoteEndpoint = 0
BotPersonality.LLM.AllowHttpWithoutTls = 1

BotPersonality.LLM.Model = local-model
BotPersonality.LLM.ApiKeyEnvironmentVariable = WOW_BOT_LLM_API_KEY

BotPersonality.LLM.ConnectTimeoutMs = 2000
BotPersonality.LLM.RequestTimeoutMs = 7000
BotPersonality.LLM.ReactiveResponseDeadlineMs = 8000
BotPersonality.LLM.ProactiveResponseDeadlineMs = 5000

BotPersonality.LLM.Workers = 2
BotPersonality.LLM.MaxInFlightRequests = 4
BotPersonality.LLM.Queue.MaxPendingRequests = 100
BotPersonality.LLM.Queue.MaxPendingPerBot = 1
BotPersonality.LLM.Queue.MaxPendingPerPlayer = 3
BotPersonality.LLM.Queue.MaxCompletedResults = 200

BotPersonality.LLM.RateLimit.MaxRequestsPerMinute = 30
BotPersonality.LLM.RateLimit.MaxRequestsPerPlayerPerMinute = 10
BotPersonality.LLM.RateLimit.MaxRequestsPerBotPerMinute = 10
BotPersonality.LLM.RateLimit.MinIntervalPerConversationMs = 3000

BotPersonality.LLM.History.Enable = 1
BotPersonality.LLM.History.MaxTurns = 8
BotPersonality.LLM.History.MaxCharacters = 2000
BotPersonality.LLM.History.ExpiryMinutes = 30
BotPersonality.LLM.History.MaxConversations = 10000

BotPersonality.LLM.MaxPromptCharacters = 6000
BotPersonality.LLM.MaxOutputCharacters = 180
BotPersonality.LLM.MaxOutputWords = 30
BotPersonality.LLM.AllowMultiline = 0
BotPersonality.LLM.TruncateLongOutput = 0

BotPersonality.LLM.Temperature = 0.8
BotPersonality.LLM.TopP = 0.9
BotPersonality.LLM.MaxTokens = 80
BotPersonality.LLM.FrequencyPenalty = 0.2
BotPersonality.LLM.PresencePenalty = 0.0

BotPersonality.LLM.FallbackToTemplates = 1
BotPersonality.LLM.CircuitBreaker.FailureThreshold = 5
BotPersonality.LLM.CircuitBreaker.OpenSeconds = 60
BotPersonality.LLM.RetryCount = 0
BotPersonality.LLM.RetryDelayMs = 250
BotPersonality.LLM.LogPrompts = 0
BotPersonality.LLM.LogResponses = 0

# Hybrid routing defaults. Critical health and low-mana events remain
# template-based because they are time-sensitive.
BotPersonality.LLM.Route.Greeting = 1
BotPersonality.LLM.Route.Farewell = 1
BotPersonality.LLM.Route.Thanks = 1
BotPersonality.LLM.Route.Praise = 1
BotPersonality.LLM.Route.Apology = 1
BotPersonality.LLM.Route.Insult = 1
BotPersonality.LLM.Route.HelpRequest = 1
BotPersonality.LLM.Route.IdentityQuestion = 1
BotPersonality.LLM.Route.WellbeingQuestion = 1
BotPersonality.LLM.Route.Agreement = 1
BotPersonality.LLM.Route.Disagreement = 1
BotPersonality.LLM.Route.Unknown = 1

BotPersonality.LLM.Route.GroupJoined = 0
BotPersonality.LLM.Route.DungeonEntered = 1
BotPersonality.LLM.Route.EliteKill = 0
BotPersonality.LLM.Route.BossKill = 1
BotPersonality.LLM.Route.Resurrection = 1
BotPersonality.LLM.Route.PlayerDeath = 0
BotPersonality.LLM.Route.RepeatedPlayerDeath = 1
BotPersonality.LLM.Route.GroupWipe = 1
BotPersonality.LLM.Route.DungeonComplete = 1
BotPersonality.LLM.Route.RaidEncounterComplete = 1
BotPersonality.LLM.Route.LowHealth = 0
BotPersonality.LLM.Route.CriticalHealth = 0
BotPersonality.LLM.Route.LowMana = 0
BotPersonality.LLM.Route.Inactivity = 0

##################################################
# BOT PERSONALITY MEMORY CONFIGURATION           #
##################################################

# Persistent long-term memory is scoped to one bot and one real player.
BotPersonality.Memory.Enable = 1
BotPersonality.Memory.DebugLogging = 0
BotPersonality.Memory.EnableGameplayMemories = 1
BotPersonality.Memory.EnableRelationshipMilestones = 1
BotPersonality.Memory.EnableConversationSummaries = 1
BotPersonality.Memory.EnablePlayerPreferences = 1

BotPersonality.Memory.MinimumImportanceToPersist = 30
BotPersonality.Memory.MinimumConfidenceToPersist = 60
BotPersonality.Memory.MaxMemoriesPerRelationship = 100
BotPersonality.Memory.MaxPinnedMemoriesPerRelationship = 20
BotPersonality.Memory.MaxSummaryCharacters = 300
BotPersonality.Memory.MaxSubjectKeyCharacters = 96

BotPersonality.Memory.Cache.MaxRelationships = 10000
BotPersonality.Memory.Cache.ExpiryMinutes = 30
BotPersonality.Memory.SaveIntervalSeconds = 60

# Conversation sessions are memory-only and contain bounded accepted turns.
BotPersonality.Memory.Conversation.SessionTimeoutMinutes = 10
BotPersonality.Memory.Conversation.MaxTurns = 20
BotPersonality.Memory.Conversation.MaxCharacters = 5000
BotPersonality.Memory.Conversation.MaxActiveSessions = 10000
BotPersonality.Memory.Conversation.MinimumTurnsToSummarize = 4
BotPersonality.Memory.Conversation.MinimumCharactersToSummarize = 120

# Summary jobs use the configured Phase 6 endpoint at lower queue priority.
BotPersonality.Memory.Summarization.EnableLlm = 1
BotPersonality.Memory.Summarization.RequestTimeoutMs = 10000
BotPersonality.Memory.Summarization.MaxQueueAgeSeconds = 60
BotPersonality.Memory.Summarization.MaxPendingRequests = 50
BotPersonality.Memory.Summarization.MaxTranscriptCharacters = 4000

BotPersonality.Memory.Retrieval.MaxMemories = 6
BotPersonality.Memory.Retrieval.MaxCharacters = 1200
BotPersonality.Memory.Retrieval.MinimumScore = 30

BotPersonality.Memory.Retention.ConversationDays = 60
BotPersonality.Memory.Retention.MinorInteractionDays = 30
BotPersonality.Memory.Retention.ConflictDays = 30
BotPersonality.Memory.Retention.GameplayDays = 365
BotPersonality.Memory.Retention.PreferenceDays = 0
BotPersonality.Memory.Retention.MilestoneDays = 0

# Raw chat is never persisted. Sensitive conversation summaries are rejected.
BotPersonality.Memory.Privacy.StoreRawChat = 0
BotPersonality.Memory.Privacy.StoreOffensiveText = 0
BotPersonality.Memory.Privacy.StoreSensitiveData = 0

BotPersonality.Memory.TemplateContext.Enable = 1

# Force proactive chance to 100% for debugging.
BotPersonality.ProactiveChat.ForceDialogueForDebug = 0
